# ============================================================
#  CELRED ADS MANAGER — plantilla del .env
# ============================================================
#  Copia este archivo como  .env  y rellena los tres primeros valores.
#  El .env de verdad NUNCA va a git: lleva un token con control total sobre
#  las dos cuentas publicitarias.
# ============================================================

# ------------------------------------------------------------
#  1. CREDENCIALES DE LA APP DE META   <-- HAY QUE PONERLAS
# ------------------------------------------------------------
#  developers.facebook.com -> tu app -> Configuracion -> Basica.
#  OJO: el App ID NO es el numero de la cuenta publicitaria.
META_APP_ID=
META_APP_SECRET=

# Token con permisos: ads_management, ads_read, business_management,
# pages_show_list, pages_read_engagement.
#
# USA UN TOKEN DE SISTEMA: Business Manager -> Usuarios del sistema ->
# Generar token. Los de usuario caducan en horas y dejan el sistema tirado a
# mitad de una subida. Comprueba cual tienes con:  npm run cuentas
META_ACCESS_TOKEN=

# ------------------------------------------------------------
#  2. CUENTAS PUBLICITARIAS
# ------------------------------------------------------------
#  Cada sede vive en una cuenta (manual, punto 7) y el sistema elige sola la
#  que toca. No hay que tocar nada de aqui al cambiar de tienda.
#
#    CA 01 -> VICTORIA, TUQUERRES, ORITO, MOCOA, MEDELLIN
#    CA 02 -> LA16, SEBASTIAN, LICEO, ZAFIRO, MARKUS, HORMIGA, PTOASIS,
#             MEDELLIN, NEIVA
META_AD_ACCOUNT_CA01=2191226887906149
META_AD_ACCOUNT_CA02=2776880309009610

#  Override manual. Si tiene valor, TODA campana se crea en esa cuenta, sin
#  importar la sede. Dejalo vacio salvo que sepas muy bien lo que haces.
META_AD_ACCOUNT_ID=

# ------------------------------------------------------------
#  3. OBLIGATORIA PARA ANUNCIOS DE WHATSAPP
# ------------------------------------------------------------
# Pagina de Facebook que publica el anuncio.
META_PAGE_ID=140694115785963

# Numero de WhatsApp destino.
# DEJALO VACIO: el numero de cada sede se lee de lineas.xlsx, que es la fuente
# unica de verdad. Solo llenalo para forzar una linea distinta.
META_WHATSAPP_NUMBER=

# ------------------------------------------------------------
#  4. OPCIONALES
# ------------------------------------------------------------

# Ruta del Excel de lineas. Vacio = ./lineas.xlsx junto a este archivo.
CELRED_LINEAS_XLSX=

# Cuenta de Instagram vinculada, para que el anuncio corra en IG con la
# identidad de Instagram en vez de la de la Pagina.
META_INSTAGRAM_ACTOR_ID=

# Pon en 1 para ver en consola todas las llamadas HTTP al Graph API.
META_DEBUG=0

# Puerto del panel. Vacio = 4317.
PANEL_PUERTO=
